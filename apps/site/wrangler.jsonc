{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlair-mail",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./build/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "post.atlair.cloud",
      "custom_domain": true
    }
  ]
}
