{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlair-mail-docs",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "routes": [
    {
      "pattern": "docs.atlair.cloud",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true }
}
